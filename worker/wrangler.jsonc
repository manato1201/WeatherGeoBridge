{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weathergeobridge-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "kv_namespaces": [
    { "binding": "WEATHER_CACHE", "id": "35200476cd4a4ffeb5f9ca02a766a2f3" },
    { "binding": "PUSH_SUBSCRIPTIONS", "id": "04fd76769c8a4a19b58c494e3d8800ef" }
  ],
  "vars": {
    "VAPID_PUBLIC_KEY": "BK3op_B-KpCUghZCBi_sKnd3kKJNCL5DzslKNkzKpi3Q4ZylIQU3R1Jl0sLptRPt2O6DmRlIrONHky1Q6IWvrcs",
    // push サービスが問題時に連絡する宛先。mailto: か https:// の URL(メールアドレスを公開リポジトリに置かないため、プロフィールの URL にしている)
    "VAPID_SUBJECT": "https://github.com/manato1201",
    // CORSを許可するオリジン(カンマ区切り)。ここに無いオリジンからのブラウザ直接呼び出しは拒否される。
    "ALLOWED_ORIGINS": "https://weathergeobridge.vercel.app,http://localhost:3000,http://localhost:3001"
  },
  // 呼び出し頻度の上限(src/auth.ts の rateLimit)。利用者(X-Client-IP)ごとに1分60回。
  // 上限を超えると429。Open-Meteoの無料枠とKV書き込みを使い切られないための歯止め。
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],
  // 15分ごとに、購読者ごとの登録地点だけを対象に天気変化を判定して通知する
  // (src/scheduled.ts)。
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
